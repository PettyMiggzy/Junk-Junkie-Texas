{
  "redirects": [
    {
      "source": "/CRM",
      "destination": "/crm/",
      "permanent": false
    },
    {
      "source": "/CRM/",
      "destination": "/crm/",
      "permanent": false
    }
  ],
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 20
    }
  },
  "crons": [
    {
      "path": "/api/gbp-sync",
      "schedule": "0 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}